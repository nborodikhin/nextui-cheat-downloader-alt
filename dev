def current_host():
    """The key of the build machine in the `hosts` of a dependency."""
    system, machine = platform_module.system(), platform_module.machine()
    if system == "Darwin":
        return "macosx_arm64" if machine == "arm64" else "macosx_x64"
    if system == "Linux" and machine in ("x86_64", "AMD64"):
        return CONTAINER_HOST
    if system == "Linux" and machine in ("aarch64", "arm64"):
        return "linux_arm64"
    raise DevError("No host build for {} {}".format(system, machine))


@dataclass
class Dependency:
    """One pinned download from deps.json.

    A dependency is one file, or one file per variant:
    - `url` with {platform}: one file per device platform.
    - `url` with {host}: one file per build machine; `hosts` maps each host
      key to the text that replaces {host}. Fetch takes the container host
      and the current host.
    `sha256` is the hash of the one file, or maps each variant to its hash.
    `unpack` is "tar", "zip", or empty for a single executable file.
    """

    name: str
    version: str
    url: str
    github: str
    sha256: object
    unpack: str = ""
    latest: str = "release"
    tag_prefix: str = ""
    hosts: dict = field(default_factory=dict)
    extra: dict = field(default_factory=dict)

    @property
    def per_platform(self):
        return "{platform}" in self.url

    @property
    def per_host(self):
        return "{host}" in self.url

    @property
    def root(self):
        return DEPS_DIR / "{}-{}".format(self.name, self.version)

    def variants(self):
        """Every variant that deps.json records a hash for."""
        if self.per_platform:
            return list(DEVICE_PLATFORMS)
        if self.per_host:
            return list(self.hosts)
        return [None]

    def needed_variants(self):
        """The variants that this machine fetches."""
        if self.per_host:
            return unique([CONTAINER_HOST, current_host()])
        return self.variants()

    def file_url(self, variant=None):
        return self.url.format(version=self.version, platform=variant,
                               host=self.hosts.get(variant))

    def expected_hashes(self, variants=None):
        """Gives {variant: sha256} for `variants` (default: every variant)."""
        if not (self.per_platform or self.per_host):
            return {None: self.sha256 or ""}
        hashes = self.sha256 if isinstance(self.sha256, dict) else {}
        return {variant: hashes.get(variant, "") for variant in variants or self.variants()}

    def path(self, variant=None):
        """The fetched file of a platform, or the unpacked tree of a host."""
        if self.per_platform:
            return self.root / variant / self.name
        if self.per_host:
            return self.root / variant
        return self.root

    def to_json(self):
        entry = dict(self.extra)
        entry.update({"name": self.name, "version": self.version, "github": self.github})
        if self.latest != "release":
            entry["latest"] = self.latest
        if self.tag_prefix:
            entry["tag_prefix"] = self.tag_prefix
        entry["url"] = self.url
        if self.hosts:
            entry["hosts"] = self.hosts
        if self.unpack:
            entry["unpack"] = self.unpack
        entry["sha256"] = self.sha256
        return entry


def load_dependencies():
    if not DEPS_MANIFEST.exists():
        raise DevError("Missing " + DEPS_MANIFEST.name)
    try:
        manifest = json.loads(DEPS_MANIFEST.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise DevError("{}: {}".format(DEPS_MANIFEST.name, error))

    dependencies = []
    known = {"name", "version", "url", "github", "sha256", "unpack", "latest", "tag_prefix",
             "hosts"}
    for index, entry in enumerate(manifest.get("dependencies", [])):
        missing = [key for key in ("name", "version", "url", "github") if key not in entry]
        if missing:
            raise DevError("{}: dependency {} is missing {}".format(
                DEPS_MANIFEST.name, index, ", ".join(missing)))
        dependencies.append(Dependency(
            name=entry["name"],
            version=entry["version"],
            url=entry["url"],
            github=entry["github"],
            sha256=entry.get("sha256", ""),
            unpack=entry.get("unpack", ""),
            latest=entry.get("latest", "release"),
            tag_prefix=entry.get("tag_prefix", ""),
            hosts=entry.get("hosts", {}),
            extra={key: value for key, value in entry.items() if key not in known},
        ))
    return dependencies


def save_dependencies(dependencies):
    content = json.dumps(
        {"dependencies": [dependency.to_json() for dependency in dependencies]}, indent=2)
    DEPS_MANIFEST.write_text(content + "\n", encoding="utf-8")


def dependency(name):
    for candidate in load_dependencies():
        if candidate.name == name:
            return candidate
    raise DevError("{} names no dependency {}".format(DEPS_MANIFEST.name, name))


def selected_dependencies(name):
    dependencies = load_dependencies()
    if name is None:
        return dependencies
    return [entry for entry in dependencies if entry.name == name] or [dependency(name)]


def sha256_of(path):
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def github_request(path):
    request = urllib.request.Request("https://api.github.com" + path)
    request.add_header("Accept", "application/vnd.github+json")
    request.add_header("User-Agent", USER_AGENT)
    token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if token:
        request.add_header("Authorization", "Bearer " + token)
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.load(response)
    except (urllib.error.URLError, json.JSONDecodeError) as error:
        raise DevError("GitHub API {}: {}".format(path, error))


def cached_download(entry, variant=None):
    """Download one file of `entry` into deps/.downloads, unless it is there.
    `deps update` hashes the file and `deps fetch` then uses it, thus each file
    is downloaded once."""
    url = entry.file_url(variant)
    name = "{}-{}-{}".format(entry.name, entry.version, variant or url.rsplit("/", 1)[-1])
    destination = DOWNLOADS_DIR / name
    if destination.exists():
        return destination
    return download(url, destination)


def download(url, destination):
    print("Downloading " + url, flush=True)
    destination.parent.mkdir(parents=True, exist_ok=True)
    partial = destination.with_name(destination.name + ".part")
    try:
        request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
        with urllib.request.urlopen(request, timeout=60) as response, partial.open("wb") as out:
            shutil.copyfileobj(response, out)
    except urllib.error.URLError as error:
        partial.unlink(missing_ok=True)
        raise DevError("Download of {} failed: {}".format(url, error))
    partial.replace(destination)
    return destination


def version_key(version):
    return tuple(int(part) for part in re.findall(r"\d+", version))


def latest_version(entry):
    if entry.latest == "tags":
        tags = github_request("/repos/{}/tags?per_page=100".format(entry.github))
        pattern = re.compile(re.escape(entry.tag_prefix) + r"(\d+\.\d+\.\d+)\Z")
        versions = [match.group(1) for match in
                    (pattern.match(tag["name"]) for tag in tags) if match]
        if not versions:
            raise DevError("{} has no version tags".format(entry.github))
        return max(versions, key=version_key)
    tag = github_request("/repos/{}/releases/latest".format(entry.github))["tag_name"]
    if entry.tag_prefix and tag.startswith(entry.tag_prefix):
        tag = tag[len(entry.tag_prefix):]
    return tag


def checked_members(bundle, staging):
    """The members of `bundle`, for Python without tar extraction filters
    (before 3.11.4 and 3.12). Refuses a member or link target outside
    `staging` and every special file, as the "data" filter does."""
    root = staging.resolve()
    for member in bundle.getmembers():
        target = (root / member.name).resolve()
        if member.issym():
            link = (target.parent / member.linkname).resolve()
        elif member.islnk():
            link = (root / member.linkname).resolve()
        else:
            link = target
        if not (member.isfile() or member.isdir() or member.issym() or member.islnk()):
            raise DevError("{}: refusing special file {}".format(bundle.name, member.name))
        for path in (target, link):
            if path != root and root not in path.parents:
                raise DevError("{}: refusing {} outside the archive".format(
                    bundle.name, member.name))
        yield member


def unpack_archive(entry, archive, destination):
    staging = Path(tempfile.mkdtemp(prefix="unpack-", dir=DEPS_DIR))
    try:
        if entry.unpack == "tar":
            with tarfile.open(archive) as bundle:
                if hasattr(tarfile, "data_filter"):
                    bundle.extractall(staging, filter="data")
                else:
                    bundle.extractall(staging, members=checked_members(bundle, staging))
        elif entry.unpack == "zip":
            with zipfile.ZipFile(archive) as bundle:
                bundle.extractall(staging)
        else:
            raise DevError("{}: unknown unpack kind {!r}".format(entry.name, entry.unpack))
        children = list(staging.iterdir())
        # An archive with one top directory gives that directory as the tree.
        tree = children[0] if len(children) == 1 and children[0].is_dir() else staging
        tree.rename(destination)
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def fetch_dependency(entry):
    """Download, check, and unpack one dependency. Does nothing when the tree
    on disk came from the same hashes."""
    hashes = entry.expected_hashes(entry.needed_variants())
    unhashed = [variant or entry.name for variant, value in hashes.items() if not value]
    if unhashed:
        raise DevError("{} {} has no sha256 for {}. Run ./dev deps update {}.".format(
            entry.name, entry.version, ", ".join(unhashed), entry.name))

    marker = entry.root / FETCHED_MARKER
    stamp = json.dumps({str(key): value for key, value in hashes.items()}, sort_keys=True)
    if marker.exists() and marker.read_text() == stamp:
        return False

    DEPS_DIR.mkdir(parents=True, exist_ok=True)
    if entry.root.exists():
        shutil.rmtree(entry.root)
    downloads = {variant: cached_download(entry, variant) for variant in hashes}
    for variant, downloaded in downloads.items():
        check_hash(entry, downloaded, hashes[variant], entry.file_url(variant))
    if entry.per_platform:
        for platform, downloaded in downloads.items():
            target = entry.path(platform)
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(downloaded), target)
            target.chmod(0o755)
    elif entry.per_host:
        entry.root.mkdir(parents=True)
        for host, downloaded in downloads.items():
            unpack_archive(entry, downloaded, entry.path(host))
            downloaded.unlink()
    elif entry.unpack:
        unpack_archive(entry, downloads[None], entry.root)
        downloads[None].unlink()
    else:
        entry.root.mkdir(parents=True)
        shutil.move(str(downloads[None]), entry.root / entry.name)
    marker.write_text(stamp)
    print("Fetched {} {}".format(entry.name, entry.version), flush=True)
    return True


def check_hash(entry, path, expected, url):
    actual = sha256_of(path)
    if actual != expected:
        path.unlink()
        raise DevError("{}: sha256 mismatch for {}\n  expected {}\n  actual   {}".format(
            entry.name, url, expected, actual))


def ensure_dependencies(names=None):
    for entry in load_dependencies():
        if names is None or entry.name in names:
            fetch_dependency(entry)


def update_dependency(entry, version):
    """Pin `entry` to `version` (the latest release when None) and record the
    hash of every file. Gives True when deps.json changed."""
    target = version or latest_version(entry)
    if target == entry.version and all(entry.expected_hashes().values()):
        print("{} {} is current".format(entry.name, entry.version))
        return False

    previous = entry.version
    entry.version = target
    if entry.per_platform or entry.per_host:
        entry.sha256 = {variant: sha256_of(cached_download(entry, variant))
                        for variant in entry.variants()}
    else:
        entry.sha256 = sha256_of(cached_download(entry))
    if previous == target:
        print("{} {}: recorded hashes".format(entry.name, target))
    else:
        print("{} {} -> {}".format(entry.name, previous, target))
    return True


def command_deps_list(_args):
    for entry in load_dependencies():
        marker = entry.root / FETCHED_MARKER
        state = "fetched" if marker.exists() else "not fetched"
        print("{:16} {:10} {:12} {}".format(entry.name, entry.version, state, entry.github))
    return 0


def command_deps_fetch(args):
    for entry in selected_dependencies(args.name):
        if not fetch_dependency(entry):
            print("{} {} is up to date".format(entry.name, entry.version))
    return 0


def command_deps_outdated(_args):
    outdated = 0
    for entry in load_dependencies():
        latest = latest_version(entry)
        if latest != entry.version:
            outdated += 1
        print("{:16} {:10} latest {}".format(entry.name, entry.version, latest))
    return 1 if outdated else 0


def command_deps_update(args):
    if args.version and not args.name:
        raise DevError("--version needs a dependency name")
    dependencies = load_dependencies()
    if args.name and args.name not in [entry.name for entry in dependencies]:
        raise DevError("{} names no dependency {}".format(DEPS_MANIFEST.name, args.name))
    changed = [entry for entry in dependencies
               if args.name in (None, entry.name) and update_dependency(entry, args.version)]
    if changed:
        save_dependencies(dependencies)
        for entry in changed:
            fetch_dependency(entry)
            # Files of other hosts were downloaded only to hash them.
            for leftover in DOWNLOADS_DIR.glob("{}-{}-*".format(entry.name, entry.version)):
                leftover.unlink()
    return 0


def command_deps(args):
    args.command_parser.print_help()
    return 0



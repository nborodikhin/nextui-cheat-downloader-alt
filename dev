# install and run - deploy to devices, or run locally against a sandbox
# ---------------------------------------------------------------------------


def run_host_sandbox(args):
    """Run the host binary against a throwaway SD card layout.

    The app reads its ROM, cheat, and cache directories from the environment
    (launch.sh sets them from NextUI's own variables on device), so pointing
    them at a temporary tree is enough to run the real UI locally.
    """
    test_root = Path(args.root).expanduser().resolve()
    if args.reset and test_root.exists():
        print("Removing " + str(test_root))
        shutil.rmtree(test_root)

    app = ROOT / APP_BINARY
    if not app.exists():
        raise DevError(
            "{} has not been built. Run './dev build' first.".format(relative(app))
        )

    rom_dir = test_root / "Roms"
    cheat_dir = test_root / "Cheats"
    cache_dir = test_root / "Cache"
    for directory in (rom_dir, cheat_dir, cache_dir):
        directory.mkdir(parents=True, exist_ok=True)

    # Empty files are enough: the app matches games by file name.
    for rom in SAMPLE_ROMS:
        rom_path = rom_dir / rom
        rom_path.parent.mkdir(parents=True, exist_ok=True)
        rom_path.touch()

    env = os.environ.copy()
    env["ROM_DIR"] = str(rom_dir)
    env["CHEAT_DIR"] = str(cheat_dir)
    env["CACHE_DIR"] = str(cache_dir)

    # Default to the terminal UI, which needs no device hardware. Anything
    # after `--` replaces those arguments.
    app_args = args.app_args or ["textui", "debug"]

    print("Sandbox: " + str(test_root))
    return run_command(["./" + app.name, *app_args], env=env, check=False).returncode


def install_or_run(args, should_run):
    """Shared body of `install` and `run`.

    Both build what the targets need, deploy to every named device, and
    optionally launch. `host` is only meaningful for run, where it means the
    local sandbox rather than a device.
    """
    targets = args.targets
    if not targets:
        if not should_run:
            raise DevError("install requires at least one target")
        targets = ["host"]

    # --delete only makes sense for a full install, so it implies one.
    full = args.full or args.delete

    # Skip the ADB round-trip entirely when nothing but the sandbox is asked
    # for - a local run should not require adb to be installed.
    only_host = all(platform_for_alias(target) == "host" for target in targets)
    devices = [] if only_host else list_devices()
    platforms, device_targets = resolve_device_targets(
        targets, devices, allow_host=should_run
    )

    if not args.no_build:
        build_targets(platforms, container_runtime(args))

    # Group by platform so a full install stages each pak only once, however
    # many devices of that platform are connected.
    by_platform = {}
    for device in device_targets:
        by_platform.setdefault(device.platform, []).append(device)

    failures = []
    for platform, matching in by_platform.items():
        package = None
        if full:
            try:
                _tools_dir, package = stage_pak(platform, strict=False)
            except DevError as error:
                failures.append(str(error))
                continue

        for device in matching:
            # One device failing should not strand the others.
            try:
                if package:
                    install_full(device, package, delete=args.delete)
                else:
                    install_binary(device)
                if should_run:
                    run_on_device(device)
            except DevError as error:
                failures.append(str(error))

    status = 0
    if should_run and "host" in platforms:
        status = run_host_sandbox(args)

    if failures:
        raise DevError("\n".join(failures))
    return status


def command_install(args):
    return install_or_run(args, should_run=args.run)


def command_run(args):
    return install_or_run(args, should_run=True)


# ---------------------------------------------------------------------------
# dist - stage and archive the release artifacts
# ---------------------------------------------------------------------------


def stage_pak(platform, strict):
    """Copy one platform's release files into release/Tools/<platform>/.

    Layout produced here (this is exactly what lands on the SD card):

        release/Tools/<platform>/Cheat Downloader Offline.pak/
            launch.sh, README.md, pak.json
            bin/arm/{minui-list, minui-presenter, cheat_manager}
    """
    tools_dir = RELEASE_DIR / "Tools" / platform
    pak_dir = tools_dir / PAK_DIR_NAME
    # Start from an empty pak so a re-run cannot inherit files from an older
    # layout - `install --full` pushes whatever is staged here.
    if pak_dir.exists():
        shutil.rmtree(pak_dir)
    bin_dir = pak_dir / REMOTE_BIN_SUBDIR
    bin_dir.mkdir(parents=True, exist_ok=True)

    missing = []

    for name in PAK_FILES:
        shutil.copy2(ROOT / name, pak_dir / name)

    # Helper binaries come from `./dev setup`, the app binary from the
    # cross-build above.
    sources = {name: DEPS / "{}-{}".format(name, platform) for name in PAK_HELPERS}
    sources[APP_BINARY] = WORKSPACE / "{}-{}".format(APP_BINARY, platform)

    for name, source in sources.items():
        if not source.exists() or not source.stat().st_size:
            missing.append(relative(source))
            continue
        destination = bin_dir / name
        shutil.copy2(source, destination)
        destination.chmod(0o755)

    if missing:
        message = "Missing build inputs for {}:\n  {}".format(
            platform, "\n  ".join(missing)
        )
        # Without --strict an incomplete pak is still staged, which is useful
        # while iterating on one platform; a release must never ship one.
        if strict:
            raise DevError(message)
        print("WARNING: " + message, file=sys.stderr)

    if strict:
        # Verify the staged tree is exactly what is expected - no leftovers
        # from an earlier run with a different layout, nothing empty.
        expected = {Path(name) for name in PAK_FILES}
        expected.update(Path(REMOTE_BIN_SUBDIR) / name for name in sources)
        actual = {
            path.relative_to(pak_dir) for path in pak_dir.rglob("*") if path.is_file()
        }
        problems = []
        if actual - expected:
            problems.append(
                "Unexpected files:\n  "
                + "\n  ".join(sorted(str(path) for path in actual - expected))
            )
        if expected - actual:
            problems.append(
                "Missing files:\n  "
                + "\n  ".join(sorted(str(path) for path in expected - actual))
            )
        if problems:
            raise DevError("\n".join(problems))

    return tools_dir, pak_dir


def create_zip(archive_path, base_dir, entries):
    """Zip `entries` (relative to base_dir) into archive_path.

    zipfile records each file's mode, so launch.sh and the binaries stay
    executable for anyone extracting the archive on a real filesystem.
    """
    archive_path.parent.mkdir(parents=True, exist_ok=True)
    archive_path.unlink(missing_ok=True)
    with zipfile.ZipFile(archive_path, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        for entry in entries:
            root = base_dir / entry
            for path in sorted(root.rglob("*")):
                if path.is_file():
                    archive.write(path, path.relative_to(base_dir))
    print("Created " + relative(archive_path))
    return archive_path


def command_dist(args):
    # Packaging is device-only: there is no host pak.
    platforms = resolve_targets(
        args.targets,
        default=["all"],
        allow_host=False,
        all_expands_to=DEVICE_PLATFORMS,
    )
    if args.strict and set(platforms) != set(DEVICE_PLATFORMS):
        raise DevError(
            "--strict requires every release platform: " + ", ".join(DEVICE_PLATFORMS)
        )

    # Start from an empty release/ so stale artifacts can never be published.
    if RELEASE_DIR.exists():
        shutil.rmtree(RELEASE_DIR)

    runtime = container_runtime(args)
    for platform in platforms:
        if not args.no_build:
            build_device(platform, runtime, release=True)
        tools_dir, _pak_dir = stage_pak(platform, strict=args.strict)
        print("Staged " + relative(tools_dir / PAK_DIR_NAME))

        if not args.no_zip:
            # Per-platform archive for a manual install into /Tools/<platform>/.
            create_zip(
                RELEASE_DIR / PAK_ZIP_TEMPLATE.format(platform=platform),
                tools_dir,
                [PAK_DIR_NAME],
            )

    if not args.no_zip:
        # Combined archive for the SD card auto-installer: it carries the
        # whole Tools/ tree, so one file covers every platform.
        create_zip(RELEASE_DIR / PAKZ_FILE_NAME, RELEASE_DIR, ["Tools"])

    return 0



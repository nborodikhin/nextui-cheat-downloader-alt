# test - unit, end-to-end, and coverage
# ---------------------------------------------------------------------------


def run_binary(path, env=None, extra=()):
    """Run a freshly built binary from the repository root."""
    command = ["./" + Path(path).name, *extra]
    print("== Running {} ==".format(command[0]), flush=True)
    return run_command(command, env=env)


def command_test(args):
    # Coverage always covers both suites, mirroring how the report is
    # published: the two runs accumulate into a single set of .gcda files.
    coverage = args.coverage
    include_e2e = args.e2e or coverage
    extra_flags = COVERAGE_FLAGS if coverage else ()

    if coverage:
        # Instrumented objects and previously collected counters have to come
        # from the same build, so start from a clean cache. Staged release
        # artifacts are unrelated and are left in place.
        remove_build_output(include_release=False)

    build_host(UNIT_TEST_SOURCE, extra_flags=extra_flags)
    run_binary(UNIT_TEST_SOURCE)

    if include_e2e:
        # The end-to-end suite drives the real binary as a subprocess, so the
        # app itself has to be built too.
        app = build_host(APP_SOURCE, extra_flags=extra_flags)
        build_host(E2E_TEST_SOURCE, extra_flags=extra_flags)
        env = os.environ.copy()
        env["CHEAT_MANAGER_BIN"] = "./" + app.name
        run_binary(E2E_TEST_SOURCE, env=env)

    if coverage:
        write_coverage_report()

    print("Tests passed.")
    return 0


def write_coverage_report(open_report=False):
    """Summarise coverage on the console and write the HTML report."""
    if not shutil.which("gcovr"):
        raise DevError("gcovr is not installed (pip install gcovr)")

    gcda = NIMCACHE / COVERAGE_GCDA
    if not gcda.exists():
        raise DevError("No coverage data at " + relative(gcda))

    COVERAGE_DIR.mkdir(parents=True, exist_ok=True)
    gcovr_flags = [
        # Report on the app itself, not on the test harness or Nim's runtime.
        "--filter",
        APP_SOURCE,
        # Nim's generated C references build-time paths that gcov cannot
        # always resolve; these keep such lookups from failing the run.
        "--gcov-ignore-errors=no_working_dir_found",
        "--gcov-ignore-errors=source_not_found",
        "--object-directory",
        str(NIMCACHE.name),
        str(gcda.relative_to(ROOT)),
    ]
    run_command(["gcovr", *gcovr_flags, "--print-summary"])
    run_command(
        [
            "gcovr",
            *gcovr_flags,
            "--html",
            "--html-details",
            "-o",
            str((COVERAGE_DIR / "index.html").relative_to(ROOT)),
        ]
    )
    print("Coverage report: {}".format(relative(COVERAGE_DIR / "index.html")))



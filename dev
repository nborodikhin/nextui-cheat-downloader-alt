def normalize_trailing_options(argv):
    """Move --podman ahead of a REMAINDER argument so it is parsed as ours.

    `./dev docker tg5040 --podman -- ls` reads naturally but would otherwise
    hand --podman to the container, because argparse stops parsing at the
    first positional.
    """
    argv = list(argv)
    if argv[:1] != ["docker"]:
        return argv
    separator = argv.index("--") if "--" in argv else len(argv)
    positions = [index for index in range(1, separator) if argv[index] == "--podman"]
    if not positions:
        return argv
    for index in reversed(positions):
        del argv[index]
    argv.insert(1, "--podman")
    return argv


def split_app_args(argv):
    """Split `./dev run ... -- app args` into our arguments and the app's.

    argparse cannot do this itself: a REMAINDER positional after a variable
    number of targets swallows the `--` instead of stopping at it.
    """
    argv = list(argv)
    if argv[:1] != ["run"] or "--" not in argv:
        return argv, []
    separator = argv.index("--")
    return argv[:separator], argv[separator + 1 :]


def main():
    parser = create_parser()
    argv, app_args = split_app_args(normalize_trailing_options(sys.argv[1:]))
    args = parser.parse_args(argv)
    if args.command is None:
        parser.print_help()
        return 0
    if app_args:
        args.app_args = app_args
    try:
        return args.handler(args)
    except DevError as error:
        print("ERROR: " + str(error), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())

def remove_path(path):
    if not path.exists() and not path.is_symlink():
        return
    print("Removing " + relative(path))
    if path.is_dir() and not path.is_symlink():
        shutil.rmtree(path)
    else:
        path.unlink()


def remove_build_output(include_release=True):
    """Delete build products, leaving downloaded prerequisites in place."""
    directories = [NIMCACHE, COVERAGE_DIR, WORKSPACE / "nimcache"]
    if include_release:
        directories.append(RELEASE_DIR)
    for directory in directories:
        remove_path(directory)

    binaries = [
        Path(source).stem
        for source in (APP_SOURCE, UNIT_TEST_SOURCE, E2E_TEST_SOURCE)
    ]
    for name in binaries:
        remove_path(ROOT / name)

    if not WORKSPACE.exists():
        return
    # Nim sources copied in for container builds, the generated build scripts,
    # and the cross-built binaries staged beside them. The compilers and miniz
    # sources are left alone.
    for path in WORKSPACE.glob("*.nim"):
        remove_path(path)
    for path in WORKSPACE.glob("build-*.sh"):
        remove_path(path)
    for name in binaries:
        for path in WORKSPACE.glob(name + "*"):
            remove_path(path)


def command_clean(args):
    remove_build_output()
    if args.deps:
        # Everything `./dev setup` produced: compilers, sources, helpers.
        remove_path(WORKSPACE)
        remove_path(DEPS)
    return 0


# ---------------------------------------------------------------------------
# version - read and edit pak.json
# ---------------------------------------------------------------------------


def load_pak():
    with PAK_FILE.open() as source:
        return json.load(source)


def save_pak(pak):
    with PAK_FILE.open("w") as destination:
        json.dump(pak, destination, indent=2)
        destination.write("\n")


def latest_version(pak):
    """The newest version: changelog entries are stored newest-first."""
    return next(iter(pak["changelog"]))


def normalize_version(version):
    return version if version.startswith("v") else "v" + version


def version_latest(pak, _args):
    version = latest_version(pak)
    print("{}: {}".format(version, pak["changelog"][version]))
    return 0


def version_list(pak, _args):
    for version, note in pak["changelog"].items():
        print("{}: {}".format(version, note))
    return 0


def version_create(pak, args):
    version = normalize_version(args.version)
    text = " ".join(args.text)
    if version in pak["changelog"]:
        raise DevError(
            "Version {} already exists. Use 'version update' to change its note.".format(
                version
            )
        )

    # The release workflow checks that pak.json's version matches the pushed
    # tag and that the tag has a non-empty changelog note, so both fields are
    # written together here.
    pak["version"] = version
    pak["changelog"] = {version: text, **pak["changelog"]}
    save_pak(pak)
    print("pak.json -> {}: {}".format(version, text))
    return 0


def version_update(pak, args):
    version = normalize_version(args.version)
    if version not in pak["changelog"]:
        raise DevError("Version {} not found in changelog.".format(version))

    text = " ".join(args.text)
    pak["changelog"][version] = text
    save_pak(pak)
    print("Updated {}: {}".format(version, text))
    return 0


def version_remove(pak, args):
    version = normalize_version(args.version)
    if version not in pak["changelog"]:
        raise DevError("Version {} not found in changelog.".format(version))

    note = pak["changelog"][version]
    confirmation = input(
        'Remove {}: "{}". Type "Remove" to confirm: '.format(version, note)
    )
    if confirmation != "Remove":
        print("Aborted.")
        return 0

    was_current = pak["version"] == version
    del pak["changelog"][version]
    if was_current:
        if not pak["changelog"]:
            raise DevError("No versions left after removal.")
        pak["version"] = latest_version(pak)
        print("Current version updated to " + pak["version"])

    save_pak(pak)
    print("Removed {}.".format(version))
    return 0


def command_version(args):
    if args.version_command is None:
        args.command_parser.print_help()
        return 0
    return args.version_handler(load_pak(), args)



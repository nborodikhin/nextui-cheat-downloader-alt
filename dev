def stage_pak(platform, kind, destination):
    """Lay out the pak of `platform` in `destination`."""
    if destination.exists():
        shutil.rmtree(destination)
    bin_dir = destination / "bin" / "arm"
    bin_dir.mkdir(parents=True)
    for name in PAK_FILES:
        shutil.copy2(ROOT / name, destination / name)
    for name in (APP_NAME, *HELPER_DEPENDENCIES):
        binary = output_dir(platform, kind) / name
        if not binary.is_file():
            raise DevError("{} is not built".format(binary.relative_to(ROOT)))
        shutil.copy2(binary, bin_dir / name)
    for path in [destination / "launch.sh", *bin_dir.iterdir()]:
        path.chmod(0o755)
    return destination


def create_zip(source_dir, archive_path):
    """Pack `source_dir` into `archive_path`, with paths relative to `source_dir`."""
    archive_path.parent.mkdir(parents=True, exist_ok=True)
    archive_path.unlink(missing_ok=True)
    with zipfile.ZipFile(archive_path, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        for path in sorted(source_dir.rglob("*")):
            if path.is_file():
                archive.write(path, path.relative_to(source_dir))
    return archive_path


def command_dist(args):
    """Build one .pakz per platform and one .pakz for every platform, each the
    tree that the package puts at the root of the SD card."""
    platforms = resolve_platforms(args.targets, default=("all",), allow_host=False)
    if args.strict and set(platforms) != set(DEVICE_PLATFORMS):
        raise DevError("--strict requires every platform: " + ", ".join(DEVICE_PLATFORMS))
    build_platforms(platforms, container_runtime(args), args.kind, args.version)

    if DIST_DIR.exists():
        shutil.rmtree(DIST_DIR)
    staging = DIST_DIR / "staging"
    for platform in platforms:
        tree = staging / platform
        stage_pak(platform, args.kind, tree / "Tools" / platform / PAK_NAME)
        archive = create_zip(tree, DIST_DIR / "{}-{}.pakz".format(PAKZ_BASE, platform))
        print("Created " + str(archive.relative_to(ROOT)))
        stage_pak(platform, args.kind, staging / "all" / "Tools" / platform / PAK_NAME)
    archive = create_zip(staging / "all", DIST_DIR / "{}.pakz".format(PAKZ_BASE))
    print("Created " + str(archive.relative_to(ROOT)))
    shutil.rmtree(staging)
    return 0



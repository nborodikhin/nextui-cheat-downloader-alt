# Build
# ---------------------------------------------------------------------------

def output_dir(platform, kind):
    return BUILD_DIR / kind / platform


def nim_tree(root):
    """The Nim tree for a build in `root`: the container one under
    CONTAINER_PROJECT, else the one of this machine."""
    host = CONTAINER_HOST if root == CONTAINER_PROJECT else current_host()
    return "{}/{}".format(root, dependency("nim").path(host).relative_to(ROOT))


def nim_flags(kind, version, root):
    """Compiler flags with the dependency paths under `root` (the repository on
    the host, or its mount point in a container)."""
    nim = nim_tree(root)
    miniz = "{}/deps/miniz-{}".format(root, dependency("miniz").version)
    flags = list(NIM_FLAGS) + [
        "-d:minizDir=" + miniz,
        # Nim pastes --passC text into the compiler's shell command unquoted.
        "--passC:-I" + shlex.quote(miniz),
        "-p:{}/pkgs/db_connector/src".format(nim),
        "-d:appVersion=" + version,
    ]
    if kind == "release":
        flags.extend(RELEASE_NIM_FLAGS)
    elif kind == "coverage":
        flags.extend(COVERAGE_NIM_FLAGS)
    return flags


def build_host(kind, version, sources=(APP_NAME,)):
    """Compile `sources` for the host. All of them share one nimcache, thus a
    coverage run merges the counters of every binary."""
    out = output_dir(HOST, kind)
    nim = nim_tree(ROOT) + "/bin/nim"
    for source in sources:
        run_command([nim, "c", *nim_flags(kind, version, ROOT),
                     "--nimcache:" + str(out / "nimcache"),
                     "-o:" + str(out / source), source + ".nim"])
    return out


def run_container(runtime, platform, command):
    container_command = [runtime, "run", "--rm"]
    if sys.stdin.isatty() and sys.stdout.isatty():
        container_command.append("-it")
    container_command.extend([
        "-v", "{}:{}".format(ROOT, CONTAINER_PROJECT),
        "-w", CONTAINER_PROJECT,
        "ghcr.io/loveretro/{}-toolchain".format(platform),
    ])
    container_command.extend(command)
    return run_command(container_command)


def build_device(platform, runtime, kind, version):
    out = output_dir(platform, kind)
    out.mkdir(parents=True, exist_ok=True)
    container_out = "{}/build/{}/{}".format(CONTAINER_PROJECT, kind, platform)
    nim = nim_tree(CONTAINER_PROJECT) + "/bin/nim"
    gcc = "${CROSS_ROOT}/bin/${CROSS_COMPILE}gcc"
    command = [
        nim, "c", "--cpu:arm64", "--os:linux",
        "--arm64.linux.gcc.exe:" + gcc,
        "--arm64.linux.gcc.linkerexe:" + gcc,
        *nim_flags(kind, version, CONTAINER_PROJECT),
        "--nimcache:" + container_out + "/nimcache",
        "-o:" + container_out + "/" + APP_NAME,
        APP_NAME + ".nim",
    ]
    # The shell expands the CROSS_* variables of the image; everything else is
    # quoted as-is.
    steps = [" ".join(arg if "${CROSS_" in arg else shlex.quote(arg) for arg in command)]
    # The MinUI helper releases keep their debug info; the pak needs none of it.
    for name in HELPER_DEPENDENCIES:
        source = dependency(name).path(platform).relative_to(ROOT)
        target = shlex.quote("{}/{}".format(container_out, name))
        steps.append("cp {} {}".format(shlex.quote(str(source)), target))
        steps.append("${CROSS_ROOT}/bin/${CROSS_COMPILE}strip " + target)
    try:
        run_container(runtime, platform, ["sh", "-c", " && ".join(steps)])
    finally:
        # A failed build leaves outputs too.
        restore_ownership(runtime, platform, out, container_out)
    return out


def restore_ownership(runtime, platform, out, container_out):
    """Give the build outputs back to the user. A rootful Docker writes them
    as root, thus ./dev clean could not remove them. Rootless Docker and Podman
    write them as the user already; a chown there would map to a subordinate
    ID, thus it runs only when an output has another owner."""
    uid, gid = os.getuid(), os.getgid()
    if all(path.lstat().st_uid == uid for path in out.rglob("*")):
        return
    run_container(runtime, platform,
                  ["chown", "-R", "{}:{}".format(uid, gid), container_out])


def build_platforms(platforms, runtime, kind, requested_version):
    version = app_version(requested_version)
    ensure_dependencies()
    for platform in platforms:
        print("== Building {} ({}, {}) ==".format(platform, kind, version), flush=True)
        if platform == HOST:
            build_host(kind, version)
        else:
            build_device(platform, runtime, kind, version)
    return version


def command_build(args):
    platforms = resolve_platforms(args.targets, default=(HOST,))
    build_platforms(platforms, container_runtime(args), args.kind, args.version)
    return 0



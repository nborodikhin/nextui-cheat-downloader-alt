def normalize_alias(value):
    return re.sub(r"[\s_-]+", "", value).lower()


def platform_for_alias(value):
    key = normalize_alias(value)
    for platform, aliases in ALIASES.items():
        if any(key == normalize_alias(alias) for alias in aliases):
            return platform
    return None


def resolve_platforms(values, default, allow_host=True):
    platforms = []
    for value in values or list(default):
        if normalize_alias(value) == "all":
            platforms.extend(DEVICE_PLATFORMS)
            continue
        platform = platform_for_alias(value)
        if not platform:
            raise DevError("Unknown platform: " + value)
        if platform == HOST and not allow_host:
            raise DevError("host is not valid for this command")
        platforms.append(platform)
    return unique(platforms)


def adb(device, *args, check=True):
    """Run ADB and return stdout as a list of lines.

    ADB emits CRLF on some hosts; carriage returns are removed before splitting.
    """
    command = ["adb"]
    if device is not None:
        command.extend(["-s", device.serial])
    command.extend(str(arg) for arg in args)
    result = run_command(command, capture=True, check=check)
    return result.stdout.decode(errors="replace").replace("\r", "").splitlines()


def adb_shell(device, *args, check=True):
    """Run one safely quoted device command and return normalized output lines."""
    return adb(device, "shell", shlex.join(str(arg) for arg in args), check=check)


def list_devices():
    devices = []
    for line in adb(None, "devices")[1:]:
        fields = line.split()
        if len(fields) < 2:
            continue
        device = Device(serial=fields[0], state=fields[1])
        if device.state == "device":
            device = detect_device(device)
        devices.append(device)
    return devices


def detect_device(device):
    cpuinfo = "\n".join(adb_shell(device, "cat", "/proc/cpuinfo", check=False))
    for identifier, platform in CPUINFO_PLATFORMS.items():
        if identifier in cpuinfo:
            return Device(device.serial, device.state, platform, identifier)

    # Match the platform check in the NextUI updater.
    model = "\n".join(adb_shell(device, "cat", "/proc/device-tree/model", check=False))
    if "sun50iw9" in model:
        return Device(device.serial, device.state, "h700", model.replace("\0", "").strip())
    return device


def resolve_devices(values):
    """Gives the connected devices that `values` select: platforms, aliases,
    ADB serials, or "device" for every supported device."""
    devices = list_devices()
    ready = [device for device in devices if device.state == "device"]
    by_serial = {device.serial: device for device in devices}
    targets = []
    for value in values or ["device"]:
        if normalize_alias(value) == "device":
            selected = [device for device in ready if device.platform in DEVICE_PLATFORMS]
            if not selected:
                raise DevError("No supported ADB devices are connected")
            targets.extend(selected)
            continue
        platform = platform_for_alias(value)
        if platform in DEVICE_PLATFORMS:
            selected = [device for device in ready if device.platform == platform]
            if not selected:
                raise DevError("No connected device matches " + platform)
            targets.extend(selected)
            continue
        device = by_serial.get(value)
        if not device:
            raise DevError("Unknown platform, alias, or ADB serial: " + value)
        if device.state != "device":
            raise DevError("ADB device {} is {}".format(value, device.state))
        if device.platform not in DEVICE_PLATFORMS:
            raise DevError("Could not detect the platform for ADB device " + value)
        targets.append(device)
    return list({device.serial: device for device in targets}.values())


def remote_pak_path(platform):
    return "{}/{}/{}".format(REMOTE_ROOT, platform, PAK_NAME)


def get_pids(device, process):
    lines = adb_shell(device, "pidof", process, check=False)
    return [pid for pid in " ".join(lines).split() if pid.isdigit()]


def descendants(device, pids):
    """Every process under `pids` on the device, the deepest first. Reads the
    parent links from /proc, thus it needs no pgrep."""
    children = {}
    # The glob needs the device shell; adb_shell would quote it.
    for line in adb(device, "shell", "cat /proc/[0-9]*/stat 2>/dev/null", check=False):
        # pid (comm) state ppid ...; comm may hold spaces, thus split after ")".
        pid, _, rest = line.partition(" (")
        fields = rest.rpartition(") ")[2].split()
        if pid.isdigit() and len(fields) > 1:
            children.setdefault(fields[1], []).append(pid)
    order = []
    def visit(pid):
        for child in children.get(pid, []):
            visit(child)
            order.append(child)
    for pid in pids:
        visit(pid)
    return order


def stop_app(device):
    """Kill the app and the MinUI helpers it started. SIGKILL does not reach
    the children, thus they go first; a helper left alive would keep the
    display and the input."""
    pids = get_pids(device, APP_NAME)
    if pids:
        adb_shell(device, "kill", "-KILL", *descendants(device, pids), *pids)
    return bool(pids)


def wait_for_nextui(device, timeout=8.0):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        pids = get_pids(device, "nextui.elf")
        if pids:
            return pids
        time.sleep(0.25)
    return []


def launch_from_nextui(device):
    """Make NextUI start the pak: NextUI runs the command in /tmp/next when it
    restarts."""
    stop_app(device)
    pids = wait_for_nextui(device)
    if not pids:
        raise DevError("nextui.elf is not running on {}. Launch the pak manually."
                       .format(device.serial))
    launch_command = "'{}/launch.sh'".format(remote_pak_path(device.platform))
    with tempfile.TemporaryDirectory(prefix="next-", dir=BUILD_DIR) as temp_dir:
        next_file = Path(temp_dir) / "next"
        next_file.write_text(launch_command)
        adb(device, "push", next_file, "/tmp/next")
    adb_shell(device, "kill", "-KILL", *pids)


# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------

VERSION_NUMBER = r"(0|[1-9][0-9]*)"
VERSION_CORE = r"v" + r"\.".join([VERSION_NUMBER] * 3)
STABLE_VERSION = re.compile(VERSION_CORE + r"\Z", re.ASCII)
OFFICIAL_VERSION = re.compile(VERSION_CORE + r"(-[a-z]+\." + VERSION_NUMBER + r")?\Z", re.ASCII)
BUILD_VERSION = re.compile(VERSION_CORE + r"(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?"
                           r"(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?\Z", re.ASCII)
VERSION_FORM = "vMAJOR.MINOR.PATCH[-pre-release][+build], no leading zeros, at most 31 characters"
# A derived version adds "+" and a build identifier of up to seven characters to a release tag.
RELEASE_TAG_MAX = 23


def checked_version(value):
    valid = isinstance(value, str) and len(value) <= 31 and BUILD_VERSION.fullmatch(value)
    if valid and "-" in value.split("+", 1)[0]:
        identifiers = value.split("+", 1)[0].split("-", 1)[1].split(".")
        valid = all(not (item.isdigit() and len(item) > 1 and item[0] == "0")
                    for item in identifiers)
    if not valid:
        raise DevError("Invalid version {!r}. Expected {}.".format(value, VERSION_FORM))
    return value


def official_version_order(value):
    core, separator, prerelease = value[1:].partition("-")
    numbers = tuple((len(part), part) for part in core.split("."))
    if not separator:
        return numbers, 1, ()
    label, number = prerelease.split(".")
    return numbers, 0, (label, len(number), number)


def app_version(requested, identifier="local"):
    """The version to bake into the binary. "auto" gives the newest release tag
    merged into HEAD (or the pak.json version without one) plus "+identifier"."""
    if requested != "auto":
        return checked_version(requested)
    tags = []
    try:
        checkout = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--show-toplevel"],
                                  capture_output=True, text=True)
        if checkout.returncode == 0 and Path(checkout.stdout.strip()).resolve() == ROOT:
            result = subprocess.run(["git", "-C", str(ROOT), "tag", "--merged", "HEAD"],
                                    capture_output=True, text=True)
            if result.returncode == 0:
                tags = [tag for tag in result.stdout.splitlines()
                        if OFFICIAL_VERSION.fullmatch(tag)]
    except FileNotFoundError:
        pass
    if tags:
        base = max(tags, key=official_version_order)
    else:
        base = load_pak().get("version")
        if not isinstance(base, str) or not STABLE_VERSION.fullmatch(base):
            raise DevError("pak.json must give a stable version, got {!r}.".format(base))
    return checked_version(base + "+" + identifier)


def load_pak():
    with PAK_FILE.open() as source:
        return json.load(source)


def save_pak(pak):
    with PAK_FILE.open("w") as destination:
        json.dump(pak, destination, indent=2)
        destination.write("\n")


def normalize_version(version):
    return version if version.startswith("v") else "v" + version


def check_release_tag(tag):
    if not OFFICIAL_VERSION.fullmatch(tag) or len(tag) > RELEASE_TAG_MAX:
        raise DevError("Invalid release tag {!r}. Expected vMAJOR.MINOR.PATCH or "
                       "vMAJOR.MINOR.PATCH-<lowercase-label>.N, with no leading zeros, "
                       "at most {} characters.".format(tag, RELEASE_TAG_MAX))


def version_get(_pak, args):
    print(app_version("auto", args.identifier))
    return 0


def version_validate_release(pak, args):
    tag = args.tag
    check_release_tag(tag)
    stable = pak.get("version")
    if not isinstance(stable, str) or not STABLE_VERSION.fullmatch(stable):
        raise DevError("pak.json must give a stable version, got {!r}.".format(stable))
    if STABLE_VERSION.fullmatch(tag):
        if tag != stable:
            raise DevError("Stable tag {} differs from pak.json version {}.".format(tag, stable))
        note = pak.get("changelog", {}).get(tag)
        if not isinstance(note, str) or not note:
            raise DevError("pak.json changelog has no note for {}.".format(tag))
    print("{} is a valid {}.".format(
        tag, "stable release" if STABLE_VERSION.fullmatch(tag) else "pre-release"))
    return 0


def version_note(pak, args):
    """Print the changelog note of a version; prints nothing when there is none,
    thus a pre-release falls back to generated notes."""
    note = pak.get("changelog", {}).get(args.version)
    if note:
        print(note)
    return 0


def version_latest(pak, _args):
    version = next(iter(pak["changelog"]))
    print("{}: {}".format(version, pak["changelog"][version]))
    return 0


def version_list(pak, _args):
    for version, note in pak["changelog"].items():
        print("{}: {}".format(version, note))
    return 0


def version_create(pak, args):
    version = normalize_version(args.version)
    if not STABLE_VERSION.fullmatch(version):
        raise DevError("Release preparation requires a stable version. "
                       "A pre-release is a tag push, with no version create.")
    check_release_tag(version)
    if version in pak["changelog"]:
        raise DevError("Version {} already exists. Use 'version update' to change its note."
                       .format(version))
    text = " ".join(args.text)
    pak["version"] = version
    pak["changelog"] = {version: text, **pak["changelog"]}
    save_pak(pak)
    print("pak.json -> {}: {}".format(version, text))
    return 0


def version_update(pak, args):
    version = normalize_version(args.version)
    if version not in pak["changelog"]:
        raise DevError("Version {} not found in changelog.".format(version))
    text = " ".join(args.text)
    pak["changelog"][version] = text
    save_pak(pak)
    print("Updated {}: {}".format(version, text))
    return 0


def version_remove(pak, args):
    version = normalize_version(args.version)
    if version not in pak["changelog"]:
        raise DevError("Version {} not found in changelog.".format(version))
    note = pak["changelog"][version]
    confirmation = input('Remove {}: "{}". Type "Remove" to confirm: '.format(version, note))
    if confirmation != "Remove":
        print("Aborted.")
        return 0

    if pak["version"] == version:
        stable_versions = [key for key in pak["changelog"]
                           if key != version and STABLE_VERSION.fullmatch(key)]
        if not stable_versions:
            raise DevError("No stable versions left after removal.")
        pak["version"] = max(stable_versions, key=official_version_order)
        print("Current version updated to " + pak["version"])
    del pak["changelog"][version]
    save_pak(pak)
    print("Removed {}.".format(version))
    return 0


def command_version(args):
    if args.version_command is None:
        args.command_parser.print_help()
        return 0
    return args.version_handler(load_pak(), args)



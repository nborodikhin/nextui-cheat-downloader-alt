def add_podman_option(parser, help_text="use Podman instead of Docker"):
    parser.add_argument("--podman", action="store_true", help=help_text)


def add_deploy_options(parser, include_run, target_help):
    """Options shared by install and run."""
    parser.add_argument("targets", nargs="*", metavar="target", help=target_help)
    add_podman_option(parser)
    parser.add_argument(
        "--full",
        action="store_true",
        help="install the complete pak (default: only the app binary)",
    )
    parser.add_argument(
        "--delete",
        action="store_true",
        help="remove the installed pak before pushing it (implies --full)",
    )
    parser.add_argument(
        "--no-build",
        action="store_true",
        help="deploy the existing binaries instead of rebuilding",
    )
    if include_run:
        parser.add_argument(
            "--run", action="store_true", help="launch the app after installing"
        )


def create_parser():
    parser = argparse.ArgumentParser(
        description="Build, test, and package the Cheat Downloader pak",
        formatter_class=CommandHelpFormatter,
    )
    subparsers = parser.add_subparsers(
        dest="command",
        title="commands",
        metavar="command",
    )

    setup = subparsers.add_parser(
        "setup",
        aliases=["prepare", "deps"],
        help="download compilers, sources, and helper binaries",
        description="download compilers, sources, and helper binaries",
        usage="%(prog)s [target ...] [-h] [--force] [--podman]",
    )
    setup.add_argument(
        "targets",
        nargs="*",
        metavar="target",
        help="one or more of all (default), host, tg5040, tg5050, my355",
    )
    setup.add_argument(
        "--force",
        action="store_true",
        help="re-download and re-unpack even if a prerequisite is present",
    )
    add_podman_option(
        setup,
        "use Podman instead of Docker to strip the helper binaries"
        " (device targets only)",
    )
    setup.set_defaults(handler=command_setup)

    build = subparsers.add_parser(
        "build",
        help="build the app",
        description="build the app",
        usage="%(prog)s [target ...] [-h] [--release] [--podman]",
    )
    build.add_argument(
        "targets",
        nargs="*",
        metavar="target",
        help="one or more of host (default), tg5040, tg5050, my355, all",
    )
    build.add_argument(
        "--release",
        action="store_true",
        help="build optimised and stripped (default: debug)",
    )
    add_podman_option(build)
    build.set_defaults(handler=command_build)

    test = subparsers.add_parser(
        "test",
        help="run the test suites",
        description="run the test suites",
        usage="%(prog)s [-h] [--e2e] [--coverage]",
    )
    test.add_argument(
        "--e2e",
        action="store_true",

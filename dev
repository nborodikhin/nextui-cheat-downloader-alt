def add_version_option(parser):
    parser.add_argument("--version", default="auto",
                        help="version in the binary (default: auto, with +local)")


def add_build_kind_option(parser, default):
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--debug", dest="kind", action="store_const", const="debug",
                       help="unoptimized, with debug info"
                       + (" (default)" if default == "debug" else ""))
    group.add_argument("--release", dest="kind", action="store_const", const="release",
                       help="optimized for size, stripped"
                       + (" (default)" if default == "release" else ""))
    parser.set_defaults(kind=default)


def add_container_runtime_options(parser):
    runtime = parser.add_mutually_exclusive_group()
    runtime.add_argument("--docker", dest="container_runtime", action="store_const",
                         const="docker", help="use Docker for device builds")
    runtime.add_argument("--podman", dest="container_runtime", action="store_const",
                         const="podman", help="use Podman for device builds")


def add_build_options(parser, kind):
    add_container_runtime_options(parser)
    add_build_kind_option(parser, kind)
    add_version_option(parser)


PLATFORM_HELP = "platform or alias: {}, host, or all".format(", ".join(DEVICE_PLATFORMS))
DEVICE_HELP = "platform, alias, ADB serial, or device (default: every connected device)"


def add_command(subparsers, name, handler, help_text, **kwargs):
    parser = subparsers.add_parser(name, help=help_text, description=help_text,
                                   formatter_class=CommandHelpFormatter, **kwargs)
    parser.set_defaults(handler=handler, command_parser=parser)
    return parser


def create_parser():
    parser = argparse.ArgumentParser(
        prog="./dev", description="Cheat Downloader Offline developer tool.",
        formatter_class=CommandHelpFormatter)
    subparsers = parser.add_subparsers(dest="command", metavar="command")

    deps = add_command(subparsers, "deps", command_deps, "manage pinned dependencies")
    deps_commands = deps.add_subparsers(dest="deps_command", metavar="command")
    add_command(deps_commands, "list", command_deps_list, "show pinned dependencies")
    fetch = add_command(deps_commands, "fetch", command_deps_fetch,
                        "download and check pinned dependencies")
    fetch.add_argument("name", nargs="?", help="one dependency (default: all)")
    add_command(deps_commands, "outdated", command_deps_outdated,
                "compare pins with the latest upstream versions")
    update = add_command(deps_commands, "update", command_deps_update,
                         "pin the latest upstream version and record its hashes")
    update.add_argument("name", nargs="?", help="one dependency (default: all)")
    update.add_argument("--version", help="pin this version instead of the latest")

    build = add_command(subparsers, "build", command_build, "compile the app")
    build.add_argument("targets", nargs="*", metavar="target",
                       help=PLATFORM_HELP + " (default: host)")
    add_build_options(build, "debug")

    test = add_command(subparsers, "test", command_test, "build and run the host tests")
    test.add_argument("suite", nargs="?", choices=("all", "unit", "e2e"), default="all",
                      help="which tests to run (default: all)")
    test.add_argument("--coverage", action="store_true",
                      help="instrument the build and write coverage/index.html")

    dist = add_command(subparsers, "dist", command_dist, "build the .pakz packages")
    dist.add_argument("targets", nargs="*", metavar="target",
                      help="device platform or alias (default: all)")
    dist.add_argument("--strict", action="store_true",
                      help="require every platform, as a release does")
    add_build_options(dist, "release")

    install = add_command(subparsers, "install", command_install,
                          "build and upload the pak to connected devices")
    install.add_argument("targets", nargs="*", metavar="target", help=DEVICE_HELP)
    install.add_argument("--run", action="store_true", help="launch the pak after the upload")
    install.add_argument("--delete", action="store_true",
                         help="remove the installed pak before the upload")
    add_build_options(install, "debug")

    run = add_command(subparsers, "run", command_run, "install and launch the pak")
    run.add_argument("targets", nargs="*", metavar="target", help=DEVICE_HELP)
    run.add_argument("--delete", action="store_true",
                     help="remove the installed pak before the upload")
    run.add_argument("-f", "--follow", action="store_true", help="follow the log after launch")
    add_build_options(run, "debug")

    kill = add_command(subparsers, "kill", command_kill, "stop the app on devices")
    kill.add_argument("targets", nargs="*", metavar="target", help=DEVICE_HELP)

    log = add_command(subparsers, "log", command_log, "show the log of the pak on a device")
    log.add_argument("targets", nargs="*", metavar="target", help=DEVICE_HELP)
    log.add_argument("-f", "--follow", action="store_true", help="follow the log")
    log.add_argument("-n", "--lines", type=int, default=50, help="lines to show (default: 50)")

    add_command(subparsers, "devices", command_devices, "list ADB devices and their platforms")

    clean = add_command(subparsers, "clean", command_clean,
                        "remove build/, dist/, and coverage/")
    clean.add_argument("--deps", action="store_true", help="remove fetched dependencies too")

    version = add_command(subparsers, "version", command_version, "manage pak.json versions")
    version_commands = version.add_subparsers(dest="version_command", metavar="command")
    get = add_command(version_commands, "get", command_version,
                      "print the version that a build bakes in")
    get.add_argument("--identifier", default="local",
                     help="build identifier after '+' (default: local)")
    get.set_defaults(version_handler=version_get)
    validate = add_command(version_commands, "validate-release", command_version,
                           "check a release tag against pak.json")
    validate.add_argument("tag")
    validate.set_defaults(version_handler=version_validate_release)
    note = add_command(version_commands, "note", command_version,
                       "print the changelog note of a version")
    note.add_argument("version")
    note.set_defaults(version_handler=version_note)
    latest = add_command(version_commands, "latest", command_version,
                         "print the newest changelog entry")
    latest.set_defaults(version_handler=version_latest)
    listing = add_command(version_commands, "list", command_version, "print the changelog")
    listing.set_defaults(version_handler=version_list)
    create = add_command(version_commands, "create", command_version,
                         "start a release: set the version and add its note")
    create.add_argument("version")
    create.add_argument("text", nargs="+")
    create.set_defaults(version_handler=version_create)
    change = add_command(version_commands, "update", command_version,
                         "replace the note of a version")
    change.add_argument("version")
    change.add_argument("text", nargs="+")
    change.set_defaults(version_handler=version_update)
    remove = add_command(version_commands, "remove", command_version,
                         "remove a version from the changelog")
    remove.add_argument("version")
    remove.set_defaults(version_handler=version_remove)
    return parser


def main():
    parser = create_parser()
    args = parser.parse_args()
    if args.command is None:
        parser.print_help()
        return 0
    try:
        BUILD_DIR.mkdir(exist_ok=True)
        return args.handler(args)
    except DevError as error:
        print("error: " + str(error), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())

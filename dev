class DevError(Exception):
    pass


def sorted_subactions(action):
    """Returns the commands of a subparsers action in alphabetical order of their
    primary names. An alias gets no entry of its own."""
    return sorted(action._get_subactions(), key=lambda command: command.dest)


class CommandHelpFormatter(argparse.HelpFormatter):
    def _format_action(self, action):
        if isinstance(action, argparse._SubParsersAction):
            format_action = super()._format_action
            return "".join(
                format_action(command) for command in sorted_subactions(action)
            )
        return super()._format_action(action)


@dataclass(frozen=True)
class Device:
    serial: str
    state: str
    platform: str = "unknown"
    hardware: str = "-"


def load_container_runtime():
    runtime = DEFAULT_CONTAINER_RUNTIME
    if not DEV_CONFIG_FILE.exists():
        return runtime

    for line_number, raw_line in enumerate(
        DEV_CONFIG_FILE.read_text(encoding="utf-8").splitlines(), start=1
    ):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise DevError(".dev:{}: expected KEY=VALUE".format(line_number))
        key, value = (part.strip() for part in line.split("=", 1))
        if key != "CONTAINER_RUNTIME":
            raise DevError(".dev:{}: unknown setting {}".format(line_number, key))
        runtime = value

    if runtime not in ("docker", "podman"):
        raise DevError(".dev: CONTAINER_RUNTIME must be docker or podman")
    return runtime


def container_runtime(args):
    return getattr(args, "container_runtime", None) or load_container_runtime()


def run_command(args, cwd=ROOT, env=None, capture=False, check=True):
    result = subprocess.run(
        [str(arg) for arg in args],
        cwd=str(cwd),
        env=env,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        check=False,
    )
    if check and result.returncode:
        if capture and result.stderr:
            sys.stderr.write(result.stderr.decode(errors="replace"))
        raise DevError("Command failed: " + shlex.join(str(a) for a in args))
    return result


def unique(values):
    return list(dict.fromkeys(values))



def command_devices(_args):
    devices = list_devices()
    if not devices:
        print("No ADB devices")
    for device in devices:
        print("{:24} {:12} {:8} {}".format(
            device.serial, device.state, device.platform, device.hardware))
    return 0


def command_install(args, run=None):
    run = args.run if run is None else run
    devices = resolve_devices(args.targets)
    platforms = unique(device.platform for device in devices)
    build_platforms(platforms, container_runtime(args), args.kind, args.version)

    failures = []
    for device in devices:
        try:
            with tempfile.TemporaryDirectory(prefix="pak-", dir=BUILD_DIR) as temp_dir:
                pak = stage_pak(device.platform, args.kind, Path(temp_dir) / PAK_NAME)
                stop_app(device)
                if args.delete:
                    adb_shell(device, "rm", "-rf", remote_pak_path(device.platform))
                parent = "{}/{}".format(REMOTE_ROOT, device.platform)
                adb_shell(device, "mkdir", "-p", parent)
                print("Uploading pak to {}:{}/".format(device.serial, parent), flush=True)
                adb(device, "push", pak, parent + "/")
            if run:
                launch_from_nextui(device)
        except DevError as error:
            failures.append("{}: {}".format(device.serial, error))
    if failures:
        raise DevError("\n".join(failures))
    return 0


def command_run(args):
    command_install(args, run=True)
    if args.follow:
        return command_log(argparse.Namespace(targets=args.targets, follow=True, lines=10))
    return 0


def command_kill(args):
    for device in resolve_devices(args.targets):
        state = "Killed" if stop_app(device) else "Not running:"
        print("{} {} on {}".format(state, APP_NAME, device.serial), flush=True)
    return 0


def command_log(args):
    devices = resolve_devices(args.targets)
    if len(devices) != 1:
        details = ", ".join("{} ({})".format(d.serial, d.platform) for d in devices)
        raise DevError("log requires exactly one device; resolved: " + details)
    device = devices[0]
    # launch.sh writes $LOGS_PATH/<pak name>.txt.
    log_path = "/mnt/SDCARD/.userdata/{}/logs/{}.txt".format(
        device.platform, PAK_NAME.rsplit(".", 1)[0])
    command = ["tail", "-n", str(args.lines)]
    if args.follow:
        command.append("-f")
    command.append(log_path)
    print("{} {}:{}".format("Following" if args.follow else "Reading",
                            device.serial, log_path), flush=True)
    return run_command(["adb", "-s", device.serial, "shell", shlex.join(command)],
                       check=False).returncode


def command_clean(args):
    for path in (BUILD_DIR, DIST_DIR, COVERAGE_DIR):
        if path.exists():
            shutil.rmtree(path)
            print("Removed " + str(path.relative_to(ROOT)))
    if args.deps:
        for entry in load_dependencies():
            for path in DEPS_DIR.glob(entry.name + "-*"):
                if path.is_dir():
                    shutil.rmtree(path)
                else:
                    path.unlink()
                print("Removed " + str(path.relative_to(ROOT)))
    return 0



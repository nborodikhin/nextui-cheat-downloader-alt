@dataclass(frozen=True)
class Device:
    """One entry from `adb devices`, with its platform once detected."""

    serial: str
    state: str
    platform: str = "unknown"
    hardware: str = "-"


class DevError(Exception):
    """Expected failure: reported as a one-line error instead of a traceback."""


class CommandHelpFormatter(argparse.HelpFormatter):
    """Print subcommands as a plain list instead of argparse's {a,b,c} blob."""

    def _format_action(self, action):
        if isinstance(action, argparse._SubParsersAction):
            format_action = super()._format_action
            return "".join(
                format_action(command) for command in action._get_subactions()
            )
        return super()._format_action(action)


# ---------------------------------------------------------------------------
# Process, download, and container helpers
# ---------------------------------------------------------------------------


def run_command(args, cwd=ROOT, env=None, capture=False, check=True):
    """Run a command, defaulting to the repository root as working directory.

    Commands are passed as a list, never through a shell, so file names with
    spaces (of which this project has plenty) need no quoting.
    """
    args = [str(argument) for argument in args]
    result = subprocess.run(
        args,
        cwd=str(cwd),
        env=env,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        check=False,
    )
    if check and result.returncode:
        if capture and result.stderr:
            sys.stderr.write(result.stderr.decode(errors="replace"))
        raise DevError("Command failed: " + " ".join(shlex.quote(a) for a in args))
    return result


def echo_run(args, **kwargs):
    """Run a command after printing it, so build logs can be replayed by hand."""
    print(" ".join(shlex.quote(str(argument)) for argument in args), flush=True)
    return run_command(args, **kwargs)


def relative(path):
    """Format a path for display, relative to the repository when possible."""
    path = Path(path)
    try:
        return str(path.relative_to(ROOT))
    except ValueError:
        return str(path)


def download(url, destination, force=False):
    """Fetch a URL to a path, skipping the work if the file is already there.

    wget and curl are preferred over urllib because they resume interrupted
    transfers and already honour the proxy settings of the environment. The
    download goes to a .part file and is renamed only on success, so an
    interrupted run can never leave a truncated file that looks complete.
    """
    destination = Path(destination)
    if destination.exists() and not force:
        print("  have {}".format(relative(destination)))
        return destination

    destination.parent.mkdir(parents=True, exist_ok=True)
    partial = destination.with_name(destination.name + ".part")
    if force:
        partial.unlink(missing_ok=True)

    print("  fetch {}".format(url))
    if shutil.which("wget"):
        command = ["wget", "-q", "--show-progress", "-c", url, "-O", str(partial)]
    elif shutil.which("curl"):
        command = ["curl", "-fL", "-C", "-", url, "-o", str(partial)]
    else:
        raise DevError("Neither wget nor curl is available to download " + url)

    run_command(command)
    partial.replace(destination)
    return destination


def extract(archive, destination):
    """Unpack a .zip/.tar.* archive into a directory, creating it if needed.

    shutil handles both formats and, for tarballs, restores the executable
    bits - which matters because the Nim archives ship compiler binaries.
    """
    destination = Path(destination)
    destination.mkdir(parents=True, exist_ok=True)
    print("  unpack {} -> {}".format(relative(archive), relative(destination)))
    shutil.unpack_archive(str(archive), str(destination))


def container_runtime(args):
    """Pick Docker or Podman based on the shared --podman flag."""
    return "podman" if getattr(args, "podman", False) else "docker"


def run_container(runtime, platform, command, check=True):
    """Run a command inside a platform toolchain container.

    workspace/ is mounted as the container's working directory, so the build
    sees the Nim compiler, the miniz sources, and the copied Nim sources at
    the same relative paths a host build uses.
    """
    container_command = [runtime, "run"]
    # Only ask for a TTY when there is one; CI runs without it.
    if sys.stdin.isatty() and sys.stdout.isatty():
        container_command.append("-it")
    container_command.extend(
        [
            "-v",
            "{}:/root/workspace".format(WORKSPACE),
            "--rm",
            TOOLCHAIN_IMAGE.format(platform=platform),
        ]
    )
    container_command.extend(str(argument) for argument in command)
    return run_command(container_command, check=check)


# ---------------------------------------------------------------------------
# Target resolution
# ---------------------------------------------------------------------------


def normalize_alias(value):
    """Fold a target name to its comparison form: lowercase, no separators."""
    return re.sub(r"[\s_-]+", "", value).lower()


def platform_for_alias(value):
    key = normalize_alias(value)
    for platform, aliases in ALIASES.items():
        if any(key == normalize_alias(alias) for alias in aliases):
            return platform
    return None


def unique(values):
    """Deduplicate while keeping the order the user asked for."""
    return list(dict.fromkeys(values))


def resolve_targets(values, default, allow_host=True, all_expands_to=ALL_TARGETS):
    """Turn command-line target names into canonical platform names.

    `all` expands to the platform set that makes sense for the command: every
    target for builds, and only the device platforms for packaging.
    """
    values = list(values) if values else list(default)
    targets = []
    for value in values:
        key = normalize_alias(value)
        if key == "all":
            targets.extend(all_expands_to)
            continue
        platform = platform_for_alias(key)
        if not platform:
            raise DevError("Unknown target: {}".format(value))
        if platform == "host" and not allow_host:
            raise DevError("host is not a valid target for this command")
        targets.append(platform)
    return unique(targets)


# ---------------------------------------------------------------------------
# ADB - talking to connected devices
# ---------------------------------------------------------------------------


def adb(device, *args, check=True):
    """Run an ADB command and return stdout as a list of lines.

    ADB emits CRLF on some hosts, so carriage returns are dropped before the
    output is split.
    """
    command = ["adb"]
    if device is not None:
        command.extend(["-s", device.serial])
    command.extend(str(argument) for argument in args)
    result = run_command(command, capture=True, check=check)
    return result.stdout.decode(errors="replace").replace("\r", "").splitlines()


def adb_shell(device, *args, check=True):
    """Run one device-side command, quoting it so paths with spaces survive."""
    return adb(device, "shell", shlex.join(str(a) for a in args), check=check)


def list_devices(detect_platforms=True):
    """Enumerate ADB devices, identifying the platform of each ready one."""
    if not shutil.which("adb"):
        raise DevError("adb is not installed or not on PATH")

    devices = []
    for line in adb(None, "devices")[1:]:  # first line is a header
        fields = line.split()
        if len(fields) < 2:
            continue
        device = Device(serial=fields[0], state=fields[1])
        if device.state == "device" and detect_platforms:
            device = detect_device(device)
        devices.append(device)
    return devices


def detect_device(device):
    """Identify a device's platform from /proc/cpuinfo."""
    cpuinfo = "\n".join(adb_shell(device, "cat", "/proc/cpuinfo", check=False))
    for identifier, platform in CPUINFO_PLATFORMS.items():
        if identifier in cpuinfo:
            return Device(
                serial=device.serial,
                state=device.state,
                platform=platform,
                hardware=identifier,
            )
    return device


def resolve_device_targets(values, devices, allow_host):
    """Expand target names into build platforms and concrete devices.

    Accepts the same names as the build commands plus `device` (every
    connected device) and raw ADB serials. Returns the platforms that need
    building and the devices to deploy to - `host` contributes a build
    platform but no device.
    """
    ready = [device for device in devices if device.state == "device"]
    by_serial = {device.serial: device for device in devices}
    build_platforms = []
    targets = []

    for value in values:
        key = normalize_alias(value)

        if key == "device":
            selected = [d for d in ready if d.platform in DEVICE_PLATFORMS]
            if not selected:
                raise DevError("No supported ADB devices are connected")
            targets.extend(selected)
            build_platforms.extend(device.platform for device in selected)
            continue

        platform = platform_for_alias(key)
        if platform == "host":
            if not allow_host:
                raise DevError("host is not a valid target for this command")
            build_platforms.append(platform)
            continue
        if platform:
            selected = [device for device in ready if device.platform == platform]
            if not selected:
                raise DevError("No connected device matches " + platform)
            targets.extend(selected)
            build_platforms.append(platform)
            continue

        # Anything left is treated as an ADB serial.
        device = by_serial.get(value)
        if not device:
            raise DevError("Unknown target, alias, or ADB serial: " + value)
        if device.state != "device":
            raise DevError("ADB device {} is {}".format(value, device.state))
        if device.platform not in DEVICE_PLATFORMS:
            raise DevError("Could not detect the platform of ADB device " + value)
        targets.append(device)
        build_platforms.append(device.platform)

    # One entry per device even if it was named several ways.
    targets = list({device.serial: device for device in targets}.values())
    return unique(build_platforms), targets


def remote_pak_path(platform):
    return "{}/{}/{}".format(REMOTE_ROOT, platform, PAK_DIR_NAME)


def get_pids(device, process):
    """Return the PIDs of a running process, or an empty list."""
    pids = " ".join(adb_shell(device, "pidof", process, check=False)).split()
    return [pid for pid in pids if pid.isdigit()]


def stop_app(device, restart=False):
    """Kill the app if it is running. Returns whether it was.

    With restart the flag file is touched first, so the loop in launch.sh
    starts the new binary instead of exiting to the menu.
    """
    pids = get_pids(device, APP_BINARY)
    if not pids:
        return False
    if restart:
        adb_shell(device, "touch", RESTART_FLAG)
    adb_shell(device, "kill", "-KILL", *pids)
    return True


def wait_for_nextui(device, timeout=8.0):
    """Wait for NextUI to come back to the foreground after the app exits."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        pids = get_pids(device, NEXTUI_PROCESS)
        if pids:
            return pids
        time.sleep(0.25)
    return []


def launch_from_nextui(device):
    """Launch the pak the way the menu does: queue it, then restart NextUI.

    NextUI reads /tmp/next on exit and runs whatever command it finds there,
    so writing the pak's launch.sh and killing NextUI starts the app with the
    same environment a normal launch would give it.
    """
    pids = wait_for_nextui(device)
    if not pids:
        raise DevError(
            "{} is not running on {}. Launch the pak from the menu instead.".format(
                NEXTUI_PROCESS, device.serial
            )
        )

    launch_command = "'{}/launch.sh'".format(remote_pak_path(device.platform))
    with tempfile.TemporaryDirectory(prefix="cheat-downloader-next-") as staging:
        next_file = Path(staging) / "next"
        next_file.write_bytes(launch_command.encode("utf-8"))
        adb(device, "push", str(next_file), "/tmp/next")
    adb_shell(device, "kill", "-KILL", *pids)


def install_binary(device):
    """Push just the app binary - the fast path while iterating on code."""
    source = WORKSPACE / "{}-{}".format(APP_BINARY, device.platform)
    if not source.exists():
        raise DevError(
            "{} is missing. Build for {} first.".format(
                relative(source), device.platform
            )
        )
    destination = "{}/{}".format(remote_pak_path(device.platform), REMOTE_BIN_SUBDIR)
    adb_shell(device, "mkdir", "-p", destination)
    adb(device, "push", str(source), "{}/{}".format(destination, APP_BINARY))
    print("  {} <- {}".format(device.serial, relative(source)))


def install_full(device, package, delete):
    """Push the whole staged pak directory.

    With delete the installed pak is removed first, which clears files left
    over from older versions. Userdata lives elsewhere and is untouched.
    """
    if delete:
        stop_app(device)
        adb_shell(device, "rm", "-rf", remote_pak_path(device.platform))
    remote_dir = "{}/{}".format(REMOTE_ROOT, device.platform)
    adb_shell(device, "mkdir", "-p", remote_dir)
    adb(device, "push", str(package), remote_dir + "/")
    print("  {} <- {}".format(device.serial, relative(package)))


def run_on_device(device):
    """Start the freshly installed app.

    If it is already running, restarting it in place is both faster and less
    disruptive than going back to the menu - but that relies on the installed
    launch.sh having the restart loop, so a pak installed before that existed
    needs one `install --full` first. Otherwise NextUI launches it.
    """
    if stop_app(device, restart=True):
        return
    launch_from_nextui(device)


def command_devices(_args):
    devices = list_devices()
    if not devices:
        print("No ADB devices found.")
        return 0

    row = "{:<24} {:<14} {:<10} {}"
    print(row.format("SERIAL", "STATE", "PLATFORM", "HARDWARE"))
    for device in devices:
        state = "connected" if device.state == "device" else device.state
        print(row.format(device.serial, state, device.platform, device.hardware))
    return 0


# ---------------------------------------------------------------------------
# setup - fetch every prerequisite
# ---------------------------------------------------------------------------


def prepare_workspace():
    """Create workspace/, deps/, and the self-symlink container builds need.

    Inside a toolchain container the working directory *is* workspace/, yet
    the compiler flags say "workspace/miniz-3.1.1". The workspace/workspace
    symlink pointing at "." makes those paths resolve in both places, so host
    and device builds can share one set of flags.
    """
    WORKSPACE.mkdir(parents=True, exist_ok=True)
    DEPS.mkdir(parents=True, exist_ok=True)
    link = WORKSPACE / "workspace"
    if not link.exists():
        link.symlink_to(".")


def setup_miniz(force):
    """Unpack the miniz C sources that get compiled into the app binary."""
    miniz_dir = ROOT / MINIZ_DIR_REL
    if (miniz_dir / "miniz.c").exists() and not force:
        print("  have {}".format(relative(miniz_dir)))
        return

    archive = download(
        "https://github.com/richgel999/miniz/releases/download/"
        "{version}/miniz-{version}.zip".format(version=MINIZ_VER),
        WORKSPACE / "miniz-{}.zip".format(MINIZ_VER),
        force=force,
    )
    # The release zip stores miniz.c at its root, so it unpacks straight into
    # the versioned directory the compiler flags point at.
    extract(archive, miniz_dir)
    if not (miniz_dir / "miniz.c").exists():
        raise DevError("miniz.c is missing from " + relative(miniz_dir))


def setup_nim(force):
    """Install the Nim compiler(s).

    The Linux x64 build is always needed: it is the compiler that runs inside
    the toolchain containers, and every build - host builds included - reads
    the db_connector package from its pkgs/ directory. On macOS a second,
    native compiler is unpacked alongside it for host builds. Both archives
    unpack as nim-<version>/, so the native one is extracted to a temporary
    directory and moved into place to avoid colliding with the Linux tree.
    """
    linux_nim = WORKSPACE / "nim-{}".format(NIM_VER) / "bin" / "nim"
    if not linux_nim.exists() or force:
        package = "nim-{}-linux_x64.tar.xz".format(NIM_VER)
        archive = download(
            "https://nim-lang.org/download/" + package,
            WORKSPACE / package,
            force=force,
        )
        extract(archive, WORKSPACE)
    else:
        print("  have {}".format(relative(linux_nim.parent.parent)))

    if os.uname().sysname != "Darwin":
        return

    native_dir = WORKSPACE / "nim-{}-host".format(NIM_VER)
    if (native_dir / "bin" / "nim").exists() and not force:
        print("  have {}".format(relative(native_dir)))
        return

    suffix = "macosx_arm64" if os.uname().machine == "arm64" else "macosx_x64"
    package = "nim-{}-{}.tar.gz".format(NIM_VER, suffix)
    archive = download(
        "https://nim-lang.org/download/" + package,
        WORKSPACE / package,
        force=force,
    )
    with tempfile.TemporaryDirectory(dir=str(WORKSPACE)) as staging:
        extract(archive, staging)
        if native_dir.exists():
            shutil.rmtree(native_dir)
        shutil.move(str(Path(staging) / "nim-{}".format(NIM_VER)), str(native_dir))


def setup_helpers(platform, runtime, force):
    """Fetch minui-list and minui-presenter for one platform.

    The published binaries carry debug info, so each one is stripped inside
    that platform's toolchain container - the only place with a matching
    ARM64 binutils - before being installed into deps/.
    """
    helpers = {
        "minui-list": (
            "https://github.com/josegonzalez/minui-list/releases/download/"
            "{version}/minui-list-{platform}"
        ).format(version=MINUI_LIST_VER, platform=platform),
        "minui-presenter": (
            "https://github.com/josegonzalez/minui-presenter/releases/download/"
            "{version}/minui-presenter-{platform}"
        ).format(version=MINUI_PRESENTER_VER, platform=platform),
    }

    for name, url in helpers.items():
        installed = DEPS / "{}-{}".format(name, platform)
        if installed.exists() and installed.stat().st_size and not force:
            print("  have {}".format(relative(installed)))
            continue

        staged_name = "{}-{}".format(name, platform)
        staged = download(url, WORKSPACE / staged_name, force=force)
        run_container(
            runtime,
            platform,
            [
                "/bin/sh",
                "-c",
                # CROSS_ROOT and CROSS_COMPILE are defined by the toolchain
                # image, so this expands inside the container, not here.
                '${CROSS_ROOT}/bin/${CROSS_COMPILE}strip ' + shlex.quote(staged_name),
            ],
        )
        shutil.copy2(staged, installed)
        # SD cards are FAT32 and ignore permission bits, but keeping these
        # executable makes the staged pak directory usable as-is locally.
        installed.chmod(0o755)
        print("  install {}".format(relative(installed)))


def command_setup(args):
    targets = resolve_targets(args.targets, default=["all"])
    runtime = container_runtime(args)

    print("== Preparing workspace ==", flush=True)
    prepare_workspace()

    print("== Nim {} ==".format(NIM_VER), flush=True)
    setup_nim(args.force)

    print("== miniz {} ==".format(MINIZ_VER), flush=True)
    setup_miniz(args.force)

    for platform in targets:
        if platform == "host":
            continue  # host builds need no per-platform helper binaries
        print("== Helper binaries for {} ==".format(platform), flush=True)
        setup_helpers(platform, runtime, args.force)

    print("Setup complete. Try './dev build' or './dev test'.")
    return 0


# ---------------------------------------------------------------------------
# build - host and cross-compiled binaries
# ---------------------------------------------------------------------------


def host_nim():
    """Locate the Nim compiler to use for builds on this machine."""
    native = WORKSPACE / "nim-{}-host".format(NIM_VER) / "bin" / "nim"
    linux = WORKSPACE / "nim-{}".format(NIM_VER) / "bin" / "nim"
    if os.uname().sysname == "Darwin" and native.exists():
        return native
    if linux.exists():
        return linux
    raise DevError("Nim is not installed. Run './dev setup' first.")


def nim_flags(release, extra=()):
    """Assemble the compiler flags shared by host and device builds."""
    flags = [
        "--threads:off",
        # miniz is compiled from source into the binary; the Nim wrapper needs
        # the directory as a define and the C compiler needs it on its
        # include path.
        "-d:minizDir={}".format(MINIZ_DIR_REL),
        "--passC:-I{}".format(MINIZ_DIR_REL),
        # db_connector ships with Nim as a bundled package rather than on the
        # default search path.
        "-p:{}".format(DB_CONNECTOR_REL),
    ]
    if release:
        # Size matters more than speed on these devices: optimise for size,
        # strip symbols, and link with LTO. The strict-aliasing opt-out keeps
        # miniz's type punning well-defined under LTO.
        flags.extend(
            [
                "-d:release",
                "-d:strip",
                "--opt:size",
                "-d:lto",
                "--passC:-fno-strict-aliasing",
                "--passL:-fno-strict-aliasing",
                "--passL:-Wno-lto-type-mismatch",
            ]
        )
    flags.extend(extra)
    return flags


def build_host(source, release=False, extra_flags=()):
    """Compile one Nim source for this machine, into the repository root."""
    output = Path(source).stem
    compiler = host_nim()  # resolved first so a missing Nim fails before output
    print("== Building {} for host ==".format(output), flush=True)
    echo_run(
        [
            compiler,
            "c",
            *nim_flags(release, extra_flags),
            "--nimcache:{}".format(NIMCACHE.name),
            "-o:{}".format(output),
            source,
        ]
    )
    return ROOT / output


def build_device(platform, runtime, source=APP_SOURCE, release=False):
    """Cross-compile one Nim source inside a platform toolchain container."""
    output = Path(source).stem
    print("== Building {} for {} ==".format(output, platform), flush=True)

    # The container only sees workspace/, so the sources have to live there.
    for nim_source in ROOT.glob("*.nim"):
        shutil.copy2(nim_source, WORKSPACE / nim_source.name)

    cache = "nimcache"
    flags = " ".join(shlex.quote(flag) for flag in nim_flags(release))
    script = "\n".join(
        [
            "#!/bin/sh",
            "# Generated by ./dev - re-run inside the {platform} toolchain with:",
            "#   ./dev docker {platform} -- /bin/sh {script_name}",
            "set -e",
            "",
            # The cache holds C output for one platform at a time. A marker
            # file records which one, so switching platforms starts clean
            # instead of linking objects from the previous architecture.
            "if [ ! -f {cache}/{platform} ]; then rm -rf {cache}; fi",
            "mkdir -p {cache}",
            "touch {cache}/{platform}",
            "",
            "nim-{version}/bin/nim c --cpu:arm64 --os:linux --nimcache:{cache} \\",
            "  --arm64.linux.gcc.exe:${{CROSS_ROOT}}/bin/${{CROSS_COMPILE}}gcc \\",
            "  --arm64.linux.gcc.linkerexe:${{CROSS_ROOT}}/bin/${{CROSS_COMPILE}}gcc \\",
            "  {flags} \\",
            "  -o:{output} {source}",
            "",
        ]
    )

    # The build script is written into workspace/ and kept there rather than
    # being passed inline, so a failing build can be inspected and re-run by
    # hand inside the container.
    script_name = "build-{}-{}.sh".format(output, platform)
    script_path = WORKSPACE / script_name
    script_path.write_text(
        script.format(
            cache=cache,
            platform=platform,
            version=NIM_VER,
            flags=flags,
            output=shlex.quote(output),
            source=shlex.quote(source),
            script_name=script_name,
        )
    )
    script_path.chmod(0o755)

    print("  script {}".format(relative(script_path)), flush=True)
    run_container(runtime, platform, ["/bin/sh", script_name])

    # Keep one binary per platform so `dist` can package them all in one pass.
    produced = WORKSPACE / output
    if not produced.exists():
        raise DevError("Build produced no binary at " + relative(produced))
    target = WORKSPACE / "{}-{}".format(output, platform)
    shutil.copy2(produced, target)
    print("  built {}".format(relative(target)))
    return target


def build_targets(targets, runtime, source=APP_SOURCE, release=False):
    for platform in targets:
        if platform == "host":
            build_host(source, release=release)
        else:
            build_device(platform, runtime, source=source, release=release)


def command_build(args):
    targets = resolve_targets(args.targets, default=["host"])
    build_targets(targets, container_runtime(args), release=args.release)
    return 0



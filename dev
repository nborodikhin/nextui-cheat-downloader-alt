def command_docker(args):
    platform = platform_for_alias(args.platform)
    if platform not in DEVICE_PLATFORMS:
        raise DevError("Invalid toolchain platform: " + args.platform)

    prepare_workspace()
    command = args.container_command
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        command = ["/bin/sh"]
    return run_container(
        container_runtime(args), platform, command, check=False
    ).returncode



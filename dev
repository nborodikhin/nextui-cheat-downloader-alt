def command_test(args):
    kind = "coverage" if args.coverage else "debug"
    out = output_dir(HOST, kind)
    if args.coverage and out.exists():
        # Counters from an earlier run would inflate this one.
        shutil.rmtree(out)
    ensure_dependencies()
    version = app_version("auto")

    suites = ("unit", "e2e") if args.suite == "all" else (args.suite,)
    sources = []
    if "unit" in suites:
        sources.append(TEST_NAME)
    if "e2e" in suites:
        sources.extend([APP_NAME, E2E_NAME])
    build_host(kind, version, sources)

    if "unit" in suites:
        run_command([out / TEST_NAME])
    if "e2e" in suites:
        env = os.environ.copy()
        env["CHEAT_MANAGER_BIN"] = str(out / APP_NAME)
        run_command([out / E2E_NAME], env=env)

    if args.coverage:
        report_coverage(out / "nimcache")
    return 0


def report_coverage(nimcache):
    if not shutil.which("gcovr"):
        raise DevError("--coverage needs gcovr on PATH")
    gcda = nimcache / "@m{}.nim.c.gcda".format(APP_NAME)
    flags = ["--filter", APP_NAME + ".nim",
             "--gcov-ignore-errors=no_working_dir_found",
             "--gcov-ignore-errors=source_not_found",
             "--object-directory", nimcache]
    run_command(["gcovr", *flags, gcda, "--print-summary"])
    COVERAGE_DIR.mkdir(exist_ok=True)
    run_command(["gcovr", *flags, gcda, "--html", "--html-details",
                 "-o", COVERAGE_DIR / "index.html"])
    print("Created " + str((COVERAGE_DIR / "index.html").relative_to(ROOT)))


